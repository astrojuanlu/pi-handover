{
  "name": "@astrojuanlu/pi-handover",
  "version": "0.3.0",
  "description": "Handover-document compaction for the pi coding agent",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "try": "pi -e ./extensions",
    "test": "node --test"
  },
  "keywords": [
    "pi-package",
    "pi",
    "compaction",
    "handover"
  ],
  "author": "Juan Luis Cano Rodr\u00edguez",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.87.1",
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "typescript": "^7.0.2"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "engines": {
    "node": ">=22.19"
  },
  "files": [
    "extensions",
    "README.md",
    "SPEC.md",
    "tsconfig.json",
    ".nvmrc"
  ]
}
